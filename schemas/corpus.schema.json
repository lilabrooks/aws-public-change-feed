{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lilabrooks.github.io/aws-public-change-feed/schemas/corpus.schema.json",
  "title": "Historical announcement corpus",
  "description": "Labeled normalized announcements used to evaluate matcher changes. Governed by ADR-018.",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_version", "items"],
  "properties": {
    "corpus_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provenance", "category", "canonical_url", "title", "expected_matches"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provenance": {
          "description": "historical items are real published announcements; synthetic items are authored to exercise a category.",
          "enum": ["historical", "synthetic"]
        },
        "category": {
          "description": "The corpus category from specification chapter 04 that this item exercises.",
          "enum": [
            "positive",
            "hard-negative",
            "overlapping-services",
            "generic-prose",
            "punctuation-variant",
            "unicode",
            "html",
            "edit",
            "security-guidance"
          ]
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "published_at": {
          "description": "Optional, because chapter 04 accepts announcements without a publication time.",
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": ".*\\S.*"
        },
        "summary": {
          "type": "string",
          "maxLength": 8000
        },
        "expected_matches": {
          "description": "Every service and risk-type pair a correct matcher must produce. An empty array marks a negative item.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expected_match"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "expected_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "risk_type"],
      "properties": {
        "service_id": {
          "$ref": "#/$defs/id"
        },
        "risk_type": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
